    "var_59ee9779ee5d": {
      "type": "variant",
      "label": "Vintage Catalog",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1540,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400..700;1,400..700&family=Public+Sans:wght@300;400;600&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n  @import url('https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.css');\n\n  :root {\n    --color-bone: #E3DAC9;\n    --color-olive: #4A5D23;\n    --color-autumn: #E86100;\n  }\n\n  body {\n    background-color: var(--color-bone);\n    color: var(--color-olive);\n    font-family: 'Public Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  h1, h2, h3, .serif {\n    font-family: 'Lora', serif;\n  }\n\n  /* Duotone Filter */\n  .duotone {\n    filter: grayscale(100%) contrast(1.2);\n    mix-blend-mode: multiply;\n  }\n  .duotone-container {\n    background-color: var(--color-olive);\n  }\n\n  /* Grid lines animation */\n  .grid-line {\n    background-color: var(--color-olive);\n    position: absolute;\n    opacity: 0.3;\n  }\n\n  /* Custom Cursor */\n  .custom-cursor {\n    width: 20px;\n    height: 20px;\n    background-color: var(--color-autumn);\n    border-radius: 50%;\n    position: fixed;\n    pointer-events: none;\n    z-index: 9999;\n    transform: translate(-50%, -50%);\n    display: none;\n    mix-blend-mode: difference;\n  }\n\n  /* Locomotive specific */\n  [data-scroll] {\n    transition: opacity 0.8s cubic-bezier(0.215, 0.61, 0.355, 1), transform 0.8s cubic-bezier(0.215, 0.61, 0.355, 1);\n  }\n  [data-scroll].is-inview {\n    opacity: 1;\n    transform: none;\n  }\n  .reveal-up {\n    opacity: 0;\n    transform: translateY(30px);\n  }\n</style>\n<div class=\"custom-cursor\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"custom mouse cursor\" data-reason=\"position and visibility updated by mouse movement and hover state scripts\" id=\"cursor\">\n</div>\n<main data-kid=\"2\" data-name=\"locomotive scroll container\" data-scroll-container=\"\">\n    <!-- HERO SECTION: #swiss-grid -->\n    <section class=\"relative h-screen w-full border-b border-[var(--color-olive)]/30 overflow-hidden\" data-kid=\"2-1\" data-name=\"hero section with grid lines\" id=\"hero\">\n        <!-- Grid Lines (Animated via Anime.js) -->\n        <div class=\"grid-line w-px h-full left-1/4 top-0 origin-top\" data-dynamic=\"true\" data-kid=\"2-1-1\" data-name=\"vertical grid line 1\" data-reason=\"height/scale animated at load by script\" id=\"line-v-1\">\n        </div>\n        <div class=\"grid-line w-px h-full left-1/2 top-0 origin-top\" data-dynamic=\"true\" data-kid=\"2-1-2\" data-name=\"vertical grid line 2\" data-reason=\"height/scale animated at load by script\" id=\"line-v-2\">\n        </div>\n        <div class=\"grid-line w-px h-full left-3/4 top-0 origin-top\" data-dynamic=\"true\" data-kid=\"2-1-3\" data-name=\"vertical grid line 3\" data-reason=\"height/scale animated at load by script\" id=\"line-v-3\">\n        </div>\n        <div class=\"grid-line w-full h-px left-0 top-1/2 origin-left\" data-dynamic=\"true\" data-kid=\"2-1-4\" data-name=\"horizontal grid line 1\" data-reason=\"width/scale animated at load by script\" id=\"line-h-1\">\n        </div>\n        <div class=\"grid grid-cols-4 grid-rows-2 h-full\" data-kid=\"2-1-5\" data-name=\"grid layout container\">\n            <!-- Top Left: Dropcap -->\n            <div class=\"col-span-1 row-span-1 border-r border-b border-[var(--color-olive)]/30 p-12 flex items-start justify-start\" data-kid=\"2-1-5-1\" data-name=\"hero dropcap container\">\n                <span class=\"serif text-9xl font-bold leading-none opacity-0 hero-text\" data-dynamic=\"true\" data-kid=\"2-1-5-1-1\" data-name=\"hero dropcap letter H\" data-reason=\"opacity animated at load by script\">\n                    H\n                </span>\n            </div>\n            <!-- Top Right: Tinted Video -->\n            <div class=\"col-span-3 row-span-1 relative overflow-hidden group\" data-kid=\"2-1-5-2\" data-name=\"hero media container\">\n                <div class=\"absolute inset-0 bg-[var(--color-olive)] mix-blend-multiply z-10 opacity-60\" data-kid=\"2-1-5-2-1\" data-name=\"video tint overlay\">\n                </div>\n                <video autoplay=\"\" class=\"w-full h-full object-cover grayscale opacity-0 hero-video\" data-dynamic=\"true\" data-kid=\"2-1-5-2-2\" data-name=\"hero video background\" data-reason=\"opacity animated at load by script\" loop=\"\" muted=\"\" playsinline=\"\" poster=\"https://images.pexels.com/videos/31938875/1950s-1960s-1970s-8mm-31938875.jpeg?auto=compress&cs=tinysrgb&fit=crop&h=630&w=1200\" preload=\"metadata\" src=\"https://videos.pexels.com/video-files/31938875/13604873_640_360_30fps.mp4\">\n                </video>\n                <div class=\"absolute top-8 right-8 z-20 text-right\" data-kid=\"2-1-5-2-3\" data-name=\"hero top right info block\">\n                    <p class=\"text-xs uppercase tracking-widest border-b border-[var(--color-olive)] inline-block pb-1 mb-2\" data-kid=\"2-1-5-2-3-1\" data-name=\"issue number label\">\n                        Issue No. 74\n                    </p>\n                    <p class=\"text-[var(--color-autumn)] italic serif\" data-kid=\"2-1-5-2-3-2\" data-name=\"portfolio category label\">\n                        Web Portfolio\n                    </p>\n                </div>\n            </div>\n            <!-- Bottom: Main Headline -->\n            <div class=\"col-span-4 row-span-1 p-12 flex flex-col justify-end\" data-kid=\"2-1-5-3\" data-name=\"hero bottom headline container\">\n                <div class=\"max-w-4xl\" data-kid=\"2-1-5-3-1\" data-name=\"hero headline text wrapper\">\n                    <h1 class=\"text-7xl lg:text-8xl serif font-medium leading-[1.1] mb-8 opacity-0 hero-text\" data-dynamic=\"true\" data-kid=\"2-1-5-3-1-1\" data-name=\"main hero headline\" data-reason=\"opacity and transform animated at load by script\">\n                        Desarrollador Full-Stack\n                        <br data-kid=\"2-1-5-3-1-1-1\" data-name=\"line break\"/>\n                        <span class=\"italic text-[var(--color-autumn)]\" data-kid=\"2-1-5-3-1-1-2\" data-name=\"highlighted job title\">\n                            & Diseñador Digital.\n                        </span>\n                    </h1>\n                    <div class=\"flex items-center gap-8 opacity-0 hero-text\" data-dynamic=\"true\" data-kid=\"2-1-5-3-1-2\" data-name=\"hero call to action group\" data-reason=\"opacity and transform animated at load by script\">\n                        <p class=\"max-w-md text-lg leading-relaxed font-light\" data-kid=\"2-1-5-3-1-2-1\" data-name=\"hero descriptive text\">\n                            Construyendo experiencias digitales con estructura técnica y estética atemporal desde 2020.\n                        </p>\n                        <a class=\"px-8 py-4 bg-[var(--color-autumn)] text-[var(--color-bone)] rounded-full uppercase text-xs tracking-widest hover:scale-105 transition-transform\" data-kid=\"2-1-5-3-1-2-2\" data-name=\"explore archive call-to-action button\" href=\"#proyectos\">\n                            Explorar Archivo\n                        </a>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- ABOUT SECTION: #vertical-thirds -->\n    <section class=\"min-h-screen w-full flex flex-col md:flex-row border-b border-[var(--color-olive)]/30\" data-kid=\"2-2\" data-name=\"about section\" id=\"sobre\">\n        <!-- Col 1: Skills -->\n        <div class=\"flex-1 border-r border-[var(--color-olive)]/30 p-12 flex flex-col justify-between\" data-kid=\"2-2-1\" data-name=\"skills column\" data-scroll=\"\">\n            <div class=\"reveal-up\" data-kid=\"2-2-1-1\" data-name=\"skills content reveal wrapper\" data-scroll=\"\">\n                <h2 class=\"text-4xl serif mb-12\" data-kid=\"2-2-1-1-1\" data-name=\"skills title\">\n                    Habilidades\n                    <br data-kid=\"2-2-1-1-1-1\" data-name=\"line break\"/>\n                    Técnicas\n                </h2>\n                <ul class=\"space-y-4 text-sm tracking-tight uppercase\" data-kid=\"2-2-1-1-2\" data-name=\"skills list\">\n                    <li class=\"flex justify-between border-b border-[var(--color-olive)]/20 pb-2\" data-kid=\"2-2-1-1-2-1\" data-name=\"skill item 1\">\n                        <span data-kid=\"2-2-1-1-2-1-1\" data-name=\"skill name 1\">\n                            React / Next.js\n                        </span>\n                        <span data-kid=\"2-2-1-1-2-1-2\" data-name=\"skill percentage 1\">\n                            95%\n                        </span>\n                    </li>\n                    <li class=\"flex justify-between border-b border-[var(--color-olive)]/20 pb-2\" data-kid=\"2-2-1-1-2-2\" data-name=\"skill item 2\">\n                        <span data-kid=\"2-2-1-1-2-2-1\" data-name=\"skill name 2\">\n                            TypeScript\n                        </span>\n                        <span data-kid=\"2-2-1-1-2-2-2\" data-name=\"skill percentage 2\">\n                            90%\n                        </span>\n                    </li>\n                    <li class=\"flex justify-between border-b border-[var(--color-olive)]/20 pb-2\" data-kid=\"2-2-1-1-2-3\" data-name=\"skill item 3\">\n                        <span data-kid=\"2-2-1-1-2-3-1\" data-name=\"skill name 3\">\n                            Node.js / Prisma\n                        </span>\n                        <span data-kid=\"2-2-1-1-2-3-2\" data-name=\"skill percentage 3\">\n                            85%\n                        </span>\n                    </li>\n                    <li class=\"flex justify-between border-b border-[var(--color-olive)]/20 pb-2\" data-kid=\"2-2-1-1-2-4\" data-name=\"skill item 4\">\n                        <span data-kid=\"2-2-1-1-2-4-1\" data-name=\"skill name 4\">\n                            Tailwind CSS\n                        </span>\n                        <span data-kid=\"2-2-1-1-2-4-2\" data-name=\"skill percentage 4\">\n                            100%\n                        </span>\n                    </li>\n                    <li class=\"flex justify-between border-b border-[var(--color-olive)]/20 pb-2\" data-kid=\"2-2-1-1-2-5\" data-name=\"skill item 5\">\n                        <span data-kid=\"2-2-1-1-2-5-1\" data-name=\"skill name 5\">\n                            PostgreSQL\n                        </span>\n                        <span data-kid=\"2-2-1-1-2-5-2\" data-name=\"skill percentage 5\">\n                            80%\n                        </span>\n                    </li>\n                </ul>\n            </div>\n            <p class=\"text-xs opacity-50 uppercase mt-8\" data-kid=\"2-2-1-2\" data-name=\"skills inventory counter\">\n                01 — Inventario\n            </p>\n        </div>\n        <!-- Col 2: Bio (Dark Olive) -->\n        <div class=\"flex-1 bg-[var(--color-olive)] text-[var(--color-bone)] p-12 flex flex-col justify-center\" data-kid=\"2-2-2\" data-name=\"biography column\" data-scroll=\"\">\n            <div class=\"reveal-up\" data-kid=\"2-2-2-1\" data-name=\"biography content reveal wrapper\" data-scroll=\"\">\n                <p class=\"text-3xl serif italic leading-relaxed mb-8\" data-kid=\"2-2-2-1-1\" data-name=\"biography quote text\">\n                    \"La tecnología debe ser tan invisible como un buen diseño, pero tan robusta como una arquitectura brutalista.\"\n                </p>\n                <p class=\"text-lg font-light leading-loose\" data-kid=\"2-2-2-1-2\" data-name=\"biography body text\">\n                    Me especializo en transformar ideas complejas en interfaces limpias y sistemas escalables. Mi enfoque combina la precisión del código moderno con una sensibilidad estética inspirada en el diseño editorial clásico.\n                </p>\n            </div>\n        </div>\n        <!-- Col 3: Image -->\n        <div class=\"flex-1 relative overflow-hidden group\" data-kid=\"2-2-3\" data-name=\"about image column\" data-scroll=\"\">\n            <div class=\"absolute inset-0 bg-[var(--color-olive)] mix-blend-multiply z-10 opacity-30 group-hover:opacity-0 transition-opacity duration-700\" data-kid=\"2-2-3-1\" data-name=\"about image overlay\">\n            </div>\n            <img alt=\"Suma Pugh on Unsplash - close up of vintage keyboard\" class=\"w-full h-full object-cover grayscale transition-transform duration-1000 group-hover:scale-110\" data-kid=\"2-2-3-2\" data-name=\"about section portrait image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1694781022804-a979fd748aac?auto=format&w=800&q=80&fit=crop\"/>\n            <div class=\"absolute bottom-8 left-8 z-20 text-[var(--color-bone)]\" data-kid=\"2-2-3-3\" data-name=\"about section image caption container\">\n                <p class=\"text-xs uppercase tracking-widest\" data-kid=\"2-2-3-3-1\" data-name=\"about section image caption\">\n                    Atelier / 1974\n                </p>\n            </div>\n        </div>\n    </section>\n    <!-- PROJECTS SECTION: #masonry-hero -->\n    <section class=\"p-12\" data-kid=\"2-3\" data-name=\"projects section\" data-scroll=\"\" id=\"proyectos\">\n        <div class=\"flex justify-between items-end mb-12\" data-kid=\"2-3-1\" data-name=\"projects section header\">\n            <h2 class=\"text-6xl serif reveal-up\" data-kid=\"2-3-1-1\" data-name=\"projects section title\" data-scroll=\"\">\n                Archivo de\n                <br data-kid=\"2-3-1-1-1\" data-name=\"line break\"/>\n                <span class=\"italic\" data-kid=\"2-3-1-1-2\" data-name=\"projects section title emphasis\">\n                    Proyectos\n                </span>\n            </h2>\n            <p class=\"text-sm uppercase tracking-widest opacity-50 reveal-up\" data-kid=\"2-3-1-2\" data-name=\"projects section subtitle\" data-scroll=\"\">\n                Selección 2024\n            </p>\n        </div>\n        <!-- Masonry-ish Grid -->\n        <div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-1 reveal-up\" data-kid=\"2-3-2\" data-name=\"projects masonry grid\" data-scroll=\"\">\n            <!-- Project Card 1 -->\n            <div class=\"relative aspect-[4/5] overflow-hidden duotone-container group project-item\" data-kid=\"2-3-2-1\" data-name=\"project card 1\">\n                <img alt=\"Soundsitive Studio on Unsplash\" class=\"w-full h-full object-cover duotone group-hover:filter-none group-hover:mix-blend-normal transition-all duration-500\" data-kid=\"2-3-2-1-1\" data-name=\"project image 1\" src=\"https://images.unsplash.com/photo-1760780567530-389d8a3fba75?auto=format&w=800&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 p-8 flex flex-col justify-end text-[var(--color-bone)] z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-3-2-1-2\" data-name=\"project card info 1\">\n                    <p class=\"text-xs uppercase tracking-tighter mb-2\" data-kid=\"2-3-2-1-2-1\" data-name=\"project category 1\">\n                        E-Commerce\n                    </p>\n                    <h3 class=\"text-3xl serif\" data-kid=\"2-3-2-1-2-2\" data-name=\"project title 1\">\n                        Retro Shop\n                    </h3>\n                </div>\n            </div>\n            <!-- Project Card 2 -->\n            <div class=\"relative aspect-[3/4] overflow-hidden duotone-container group project-item mt-12 md:mt-0\" data-kid=\"2-3-2-2\" data-name=\"project card 2\">\n                <img alt=\"Sorin Basangeac on Unsplash\" class=\"w-full h-full object-cover duotone group-hover:filter-none group-hover:mix-blend-normal transition-all duration-500\" data-kid=\"2-3-2-2-1\" data-name=\"project image 2\" src=\"https://images.unsplash.com/photo-1698825598805-c9e788e6cff3?auto=format&w=800&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 p-8 flex flex-col justify-end text-[var(--color-bone)] z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-3-2-2-2\" data-name=\"project card info 2\">\n                    <p class=\"text-xs uppercase tracking-tighter mb-2\" data-kid=\"2-3-2-2-2-1\" data-name=\"project category 2\">\n                        SaaS Dashboard\n                    </p>\n                    <h3 class=\"text-3xl serif\" data-kid=\"2-3-2-2-2-2\" data-name=\"project title 2\">\n                        Audio Pulse\n                    </h3>\n                </div>\n            </div>\n            <!-- Project Card 3 -->\n            <div class=\"relative aspect-square overflow-hidden duotone-container group project-item lg:col-span-1\" data-kid=\"2-3-2-3\" data-name=\"project card 3\">\n                <img alt=\"Norman Hermle on Unsplash\" class=\"w-full h-full object-cover duotone group-hover:filter-none group-hover:mix-blend-normal transition-all duration-500\" data-kid=\"2-3-2-3-1\" data-name=\"project image 3\" src=\"https://images.unsplash.com/photo-1626126525134-fbbc07afb32c?auto=format&w=800&q=80&fit=crop\"/>\n                <div class=\"absolute inset-0 p-8 flex flex-col justify-end text-[var(--color-bone)] z-20 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity\" data-kid=\"2-3-2-3-2\" data-name=\"project card info 3\">\n                    <p class=\"text-xs uppercase tracking-tighter mb-2\" data-kid=\"2-3-2-3-2-1\" data-name=\"project category 3\">\n                        Portfolio\n                    </p>\n                    <h3 class=\"text-3xl serif\" data-kid=\"2-3-2-3-2-2\" data-name=\"project title 3\">\n                        Studio Minimal\n                    </h3>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- CONTACT SECTION: #classic-table -->\n    <section class=\"p-12 min-h-screen flex flex-col justify-center border-t border-[var(--color-olive)]/30\" data-kid=\"2-4\" data-name=\"contact section\" id=\"contacto\">\n        <div class=\"max-w-4xl mx-auto w-full\" data-kid=\"2-4-1\" data-name=\"contact section content container\">\n            <div class=\"flex items-center gap-4 mb-12 reveal-up\" data-kid=\"2-4-1-1\" data-name=\"contact header group\" data-scroll=\"\">\n                <div class=\"w-12 h-px bg-[var(--color-olive)]\" data-kid=\"2-4-1-1-1\" data-name=\"contact header decorative line\">\n                </div>\n                <h2 class=\"text-xs uppercase tracking-[0.4em]\" data-kid=\"2-4-1-1-2\" data-name=\"contact section title\">\n                    Directorio de Contacto\n                </h2>\n            </div>\n            <table class=\"w-full border-collapse reveal-up\" data-kid=\"2-4-1-2\" data-name=\"contact directory table\" data-scroll=\"\">\n                <thead data-kid=\"2-4-1-2-1\" data-name=\"table head\">\n                    <tr class=\"border-b-2 border-[var(--color-olive)] text-left uppercase text-[10px] tracking-widest font-bold\" data-kid=\"2-4-1-2-1-1\" data-name=\"table header row\">\n                        <th class=\"py-6 w-1/4\" data-kid=\"2-4-1-2-1-1-1\" data-name=\"table header column 1\">\n                            Canal\n                        </th>\n                        <th class=\"py-6 w-1/2\" data-kid=\"2-4-1-2-1-1-2\" data-name=\"table header column 2\">\n                            Identificación\n                        </th>\n                        <th class=\"py-6 text-right\" data-kid=\"2-4-1-2-1-1-3\" data-name=\"table header column 3\">\n                            Acción\n                        </th>\n                    </tr>\n                </thead>\n                <tbody class=\"text-lg serif italic\" data-kid=\"2-4-1-2-2\" data-name=\"table body\">\n                    <tr class=\"border-b border-[var(--color-olive)]/20 hover:bg-[var(--color-autumn)]/5 transition-colors group\" data-kid=\"2-4-1-2-2-1\" data-name=\"contact row 1\">\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-1-1\" data-name=\"contact label 1\">\n                            Email\n                        </td>\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-1-2\" data-name=\"contact value 1\">\n                            hola@miportafolio.com\n                        </td>\n                        <td class=\"py-8 text-right\" data-kid=\"2-4-1-2-2-1-3\" data-name=\"contact action 1\">\n                            <a class=\"text-[var(--color-autumn)] text-2xl group-hover:translate-x-2 transition-transform inline-block\" data-kid=\"2-4-1-2-2-1-3-1\" data-name=\"email link button\" href=\"mailto:hola@miportafolio.com\">\n                                <i class=\"ti ti-plus\" data-kid=\"2-4-1-2-2-1-3-1-1\" data-name=\"plus icon 1\">\n                                </i>\n                            </a>\n                        </td>\n                    </tr>\n                    <tr class=\"border-b border-[var(--color-olive)]/20 hover:bg-[var(--color-autumn)]/5 transition-colors group\" data-kid=\"2-4-1-2-2-2\" data-name=\"contact row 2\">\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-2-1\" data-name=\"contact label 2\">\n                            LinkedIn\n                        </td>\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-2-2\" data-name=\"contact value 2\">\n                            linkedin.com/in/nombre\n                        </td>\n                        <td class=\"py-8 text-right\" data-kid=\"2-4-1-2-2-2-3\" data-name=\"contact action 2\">\n                            <a class=\"text-[var(--color-autumn)] text-2xl group-hover:translate-x-2 transition-transform inline-block\" data-kid=\"2-4-1-2-2-2-3-1\" data-name=\"linkedin link button\" href=\"#\">\n                                <i class=\"ti ti-plus\" data-kid=\"2-4-1-2-2-2-3-1-1\" data-name=\"plus icon 2\">\n                                </i>\n                            </a>\n                        </td>\n                    </tr>\n                    <tr class=\"border-b border-[var(--color-olive)]/20 hover:bg-[var(--color-autumn)]/5 transition-colors group\" data-kid=\"2-4-1-2-2-3\" data-name=\"contact row 3\">\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-3-1\" data-name=\"contact label 3\">\n                            GitHub\n                        </td>\n                        <td class=\"py-8\" data-kid=\"2-4-1-2-2-3-2\" data-name=\"contact value 3\">\n                            github.com/usuario\n                        </td>\n                        <td class=\"py-8 text-right\" data-kid=\"2-4-1-2-2-3-3\" data-name=\"contact action 3\">\n                            <a class=\"text-[var(--color-autumn)] text-2xl group-hover:translate-x-2 transition-transform inline-block\" data-kid=\"2-4-1-2-2-3-3-1\" data-name=\"github link button\" href=\"#\">\n                                <i class=\"ti ti-plus\" data-kid=\"2-4-1-2-2-3-3-1-1\" data-name=\"plus icon 3\">\n                                </i>\n                            </a>\n                        </td>\n                    </tr>\n                </tbody>\n            </table>\n            <div class=\"mt-32 flex justify-between items-end opacity-30 reveal-up\" data-kid=\"2-4-1-3\" data-name=\"footer info container\" data-scroll=\"\">\n                <div data-kid=\"2-4-1-3-1\" data-name=\"footer location group\">\n                    <p class=\"text-[10px] uppercase font-bold tracking-widest mb-2\" data-kid=\"2-4-1-3-1-1\" data-name=\"location label\">\n                        Ubicación\n                    </p>\n                    <p class=\"serif italic\" data-kid=\"2-4-1-3-1-2\" data-name=\"location value\">\n                        Ciudad de México, MX\n                    </p>\n                </div>\n                <div class=\"text-right\" data-kid=\"2-4-1-3-2\" data-name=\"footer copyright group\">\n                    <p class=\"text-[10px] uppercase font-bold tracking-widest mb-2\" data-kid=\"2-4-1-3-2-1\" data-name=\"copyright label\">\n                        Copyright\n                    </p>\n                    <p class=\"serif italic\" data-kid=\"2-4-1-3-2-2\" data-name=\"copyright value\">\n                        © 1974 / 2024\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n</main>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/locomotive-scroll@5/bundled/locomotive-scroll.min.js\">\n</script>\n<script type=\"module\">\n    import { animate, timeline, spring, stagger } from 'https://esm.sh/animejs@4';\n\n  // 1. Initialize Locomotive Scroll\n  const scroller = new LocomotiveScroll({\n    el: document.querySelector('[data-scroll-container]'),\n    smooth: true,\n    lerp: 0.05\n  });\n\n  // 2. Entrance Animation (Anime.js)\n  const heroTL = timeline();\n\n  // Draw Grid Lines\n  heroTL.add({\n    targets: '.grid-line',\n    scaleY: [0, 1],\n    scaleX: (el) => el.id.includes('h') ? [0, 1] : 1,\n    opacity: [0, 0.3],\n    duration: 1500,\n    easing: 'easeInOutExpo',\n    delay: stagger(200)\n  });\n\n  // Reveal Video and Text\n  heroTL.add({\n    targets: '.hero-video',\n    opacity: [0, 1],\n    duration: 1000,\n    easing: 'easeOutQuad'\n  }, '-=800');\n\n  heroTL.add({\n    targets: '.hero-text',\n    opacity: [0, 1],\n    translateY: [40, 0],\n    duration: 800,\n    easing: 'easeOutCubic',\n    delay: stagger(150)\n  }, '-=500');\n\n  // 3. Custom Cursor for Projects\n  const cursor = document.querySelector('#cursor');\n  const projectItems = document.querySelectorAll('.project-item');\n\n  document.addEventListener('mousemove', (e) => {\n    animate(cursor, {\n      x: e.clientX,\n      y: e.clientY,\n      duration: 100,\n      easing: 'easeOutQuad'\n    });\n  });\n\n  projectItems.forEach(item => {\n    item.addEventListener('mouseenter', () => {\n      cursor.style.display = 'block';\n      animate(cursor, {\n        scale: [0, 4],\n        duration: 300,\n        easing: spring()\n      });\n    });\n    item.addEventListener('mouseleave', () => {\n      animate(cursor, {\n        scale: 0,\n        duration: 200,\n        easing: 'easeInQuad'\n      }).finished.then(() => {\n        cursor.style.display = 'none';\n      });\n    });\n  });\n\n  // 4. Parallax effect for \"Sobre\" column images via Locomotive Scroll\n  // Already handled by data-scroll and standard Locomotive behavior\n</script>\n",
      "comments": [],
      "created": "2026-07-21T23:42:31.914190+00:00",
      "modified": "2026-07-21T23:43:02.322366+00:00",
      "id": "var_59ee9779ee5d",
      "viewportScrollY": 44
    },
    "var_1120b83c45ff": {
      "type": "variant",
      "label": "70s Record Sleeve",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 3080,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,700;0,9..144,900;1,9..144,400;1,9..144,700&family=Work+Sans:wght@400;500;600&display=swap');\n  \n  :root {\n    --color-bg: #F5F5DC;\n    --color-text: #964B00;\n    --color-accent-1: #FF7518;\n    --color-accent-2: #568203;\n  }\n\n  body {\n    background-color: var(--color-bg);\n    color: var(--color-text);\n    font-family: 'Work Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-groovy { font-family: 'Fraunces', serif; }\n  \n  /* Noise Overlay */\n  .noise-overlay {\n    position: fixed;\n    top: -50%; left: -50%; width: 200%; height: 200%;\n    background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.6' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    opacity: 0.12;\n    pointer-events: none;\n    z-index: 100;\n    animation: jitter 0.1s steps(2) infinite;\n  }\n  @keyframes jitter {\n    0% { transform: translate(0,0); }\n    100% { transform: translate(1px, 1px); }\n  }\n\n  .blob-mask {\n    border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%;\n    overflow: hidden;\n  }\n\n  .diagonal-bg {\n    clip-path: polygon(0 0, 100% 0, 100% 85%, 0% 100%);\n  }\n\n  .washi-tape {\n    background: rgba(220, 200, 100, 0.45);\n    width: 120px;\n    height: 24px;\n    transform: rotate(-2deg);\n    box-shadow: inset 0 0 10px rgba(0,0,0,0.05);\n  }\n\n  .dymo-label {\n    background: #1a1a1a;\n    color: #eee;\n    padding: 2px 10px;\n    font-family: 'Courier New', Courier, monospace;\n    font-weight: bold;\n    text-transform: uppercase;\n    box-shadow: 2px 2px 0px rgba(0,0,0,0.3);\n    font-size: 0.85rem;\n    letter-spacing: 0.05em;\n  }\n\n  .stacked-paper {\n    position: relative;\n    background: #fff;\n    box-shadow: 0 4px 20px rgba(0,0,0,0.08);\n  }\n  .stacked-paper::after {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: #fff;\n    border: 1px solid #e2e2ca;\n    z-index: -1;\n    transform: rotate(2deg);\n  }\n  .stacked-paper::before {\n    content: '';\n    position: absolute;\n    inset: 0;\n    background: #fff;\n    border: 1px solid #e2e2ca;\n    z-index: -2;\n    transform: rotate(-1.5deg);\n  }\n\n  .no-scrollbar::-webkit-scrollbar { display: none; }\n  .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }\n\n  /* Custom Cursor */\n  .custom-cursor {\n    width: 24px; height: 24px;\n    background: var(--color-accent-1);\n    border-radius: 50%;\n    position: fixed;\n    pointer-events: none;\n    z-index: 1000;\n    mix-blend-mode: difference;\n    display: none;\n  }\n</style>\n<div class=\"noise-overlay\" data-kid=\"1\" data-name=\"noise overlay container\">\n</div>\n<div class=\"custom-cursor\" data-dynamic=\"true\" data-kid=\"2\" data-name=\"custom mouse cursor\" data-reason=\"position updated on mouse movement by GSAP script\">\n</div>\n<nav class=\"fixed top-0 left-0 w-full p-10 z-50 flex justify-between items-center mix-blend-multiply\" data-kid=\"3\" data-name=\"navigation bar\">\n    <div class=\"font-groovy text-3xl font-black tracking-tighter\" data-kid=\"3-1\" data-name=\"site logo container\">\n        RED\n        <span class=\"text-[var(--color-accent-1)]\" data-kid=\"3-1-1\" data-name=\"site logo suffix\">\n            70\n        </span>\n    </div>\n    <div class=\"hidden md:flex space-x-12 font-groovy text-lg font-bold\" data-kid=\"3-2\" data-name=\"navigation link menu\">\n        <a class=\"hover:text-[var(--color-accent-1)] hover:italic transition-all\" data-kid=\"3-2-1\" data-name=\"about navigation link\" href=\"#sobre\">\n            SOBRE MÍ\n        </a>\n        <a class=\"hover:text-[var(--color-accent-1)] hover:italic transition-all\" data-kid=\"3-2-2\" data-name=\"work navigation link\" href=\"#proyectos\">\n            TRABAJOS\n        </a>\n        <a class=\"hover:text-[var(--color-accent-1)] hover:italic transition-all\" data-kid=\"3-2-3\" data-name=\"contact navigation link\" href=\"#contacto\">\n            HOLA\n        </a>\n    </div>\n</nav>\n<main data-kid=\"4\" data-name=\"main page content\">\n    <!-- HERO SECTION -->\n    <section class=\"min-h-screen flex items-center relative pt-20\" data-kid=\"4-1\" data-name=\"hero section\">\n        <div class=\"container mx-auto px-10 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center\" data-kid=\"4-1-1\" data-name=\"hero content wrapper\">\n            <div class=\"z-10\" data-kid=\"4-1-1-1\" data-name=\"hero text content block\">\n                <div class=\"inline-block px-4 py-1 border border-[var(--color-text)] rounded-full text-xs font-bold mb-8 uppercase tracking-widest opacity-60\" data-kid=\"4-1-1-1-1\" data-name=\"hero version tag\">\n                    Vol. 01 / 2026\n                </div>\n                <h1 class=\"font-groovy text-7xl xl:text-9xl leading-[0.9] mb-10 gsap-hero-text\" data-kid=\"4-1-1-1-2\" data-name=\"hero main headline\">\n                    Diseño que\n                    <span class=\"italic text-[var(--color-accent-1)]\" data-kid=\"4-1-1-1-2-1\" data-name=\"hero headline italic highlight\">\n                        respira\n                    </span>\n                    y suena a\n                    <span class=\"underline decoration-wavy decoration-[var(--color-accent-2)]\" data-kid=\"4-1-1-1-2-2\" data-name=\"hero headline decorated highlight\">\n                        vinilo\n                    </span>\n                    .\n                </h1>\n                <p class=\"text-xl max-w-lg mb-12 opacity-80 leading-relaxed gsap-hero-text\" data-kid=\"4-1-1-1-3\" data-name=\"hero subheadline description\">\n                    Soy un desarrollador que cree en la calidez del pasado combinada con la potencia del presente. Creando interfaces con alma y código robusto.\n                </p>\n                <div class=\"flex flex-wrap gap-6 gsap-hero-text\" data-kid=\"4-1-1-1-4\" data-name=\"hero call-to-action button group\">\n                    <a class=\"group relative px-10 py-5 bg-[var(--color-text)] text-[var(--color-bg)] font-groovy text-xl rounded-sm overflow-hidden transition-transform hover:scale-105 active:scale-95\" data-kid=\"4-1-1-1-4-1\" data-name=\"primary call-to-action link\" href=\"#proyectos\">\n                        <span class=\"relative z-10\" data-kid=\"4-1-1-1-4-1-1\" data-name=\"call-to-action button label\">\n                            EXPLORAR ÁLBUM\n                        </span>\n                        <div class=\"absolute inset-0 bg-[var(--color-accent-1)] translate-y-full group-hover:translate-y-0 transition-transform duration-500 ease-out\" data-kid=\"4-1-1-1-4-1-2\" data-name=\"call-to-action hover reveal background\">\n                        </div>\n                    </a>\n                </div>\n            </div>\n            <div class=\"relative gsap-hero-image\" data-kid=\"4-1-1-2\" data-name=\"hero image showcase area\">\n                <div class=\"w-full aspect-square blob-mask relative shadow-2xl\" data-kid=\"4-1-1-2-1\" data-name=\"hero image blob mask container\">\n                    <img alt=\"Vintage Studio Setup by Zhengyang TIAN\" class=\"w-full h-full object-cover scale-110 hover:scale-100 transition-transform duration-1000\" data-kid=\"4-1-1-2-1-1\" data-name=\"hero visual image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35836063/pexels-photo-35836063.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                    <div class=\"absolute inset-0 bg-[var(--color-accent-1)] mix-blend-multiply opacity-20\" data-kid=\"4-1-1-2-1-2\" data-name=\"hero image color filter overlay\">\n                    </div>\n                </div>\n                <!-- Decorative elements -->\n                <div class=\"absolute -top-10 -left-10 w-40 h-40 bg-[var(--color-accent-2)] rounded-full blur-[100px] opacity-30 animate-pulse\" data-kid=\"4-1-1-2-2\" data-name=\"hero decorative animated pulse orb\">\n                </div>\n                <div class=\"absolute -bottom-10 -right-10 w-60 h-60 bg-[var(--color-accent-1)] rounded-full blur-[120px] opacity-20\" data-kid=\"4-1-1-2-3\" data-name=\"hero decorative static glow orb\">\n                </div>\n            </div>\n        </div>\n        <!-- Diagonal background element -->\n        <div class=\"absolute inset-0 bg-white/30 diagonal-bg -z-10\" data-kid=\"4-1-2\" data-name=\"hero background diagonal layer\">\n        </div>\n    </section>\n    <!-- ABOUT SECTION -->\n    <section class=\"py-40 bg-[#e8e8d5] relative overflow-hidden\" data-kid=\"4-2\" data-name=\"about section\" id=\"sobre\">\n        <div class=\"container mx-auto px-10\" data-kid=\"4-2-1\" data-name=\"about section content container\">\n            <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-20 items-center\" data-kid=\"4-2-1-1\" data-name=\"about section layout grid\">\n                <div class=\"lg:col-span-5 relative\" data-kid=\"4-2-1-1-1\" data-name=\"about photo card stack container\">\n                    <div class=\"bg-white p-6 shadow-2xl rotate-[-3deg] relative z-10 gsap-about-reveal\" data-kid=\"4-2-1-1-1-1\" data-name=\"about polaroid image card\">\n                        <div class=\"absolute -top-4 left-1/2 -translate-x-1/2 washi-tape\" data-kid=\"4-2-1-1-1-1-1\" data-name=\"decorative washi tape graphic\">\n                        </div>\n                        <div class=\"aspect-[4/5] overflow-hidden bg-[#964B00]\" data-kid=\"4-2-1-1-1-1-2\" data-name=\"profile photo wrapper\">\n                            <img alt=\"Profile Polaroid by Inga Seliverstova\" class=\"w-full h-full object-cover sepia grayscale hover:grayscale-0 transition-all duration-1000\" data-kid=\"4-2-1-1-1-1-2-1\" data-name=\"profile portrait photo\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/3589898/pexels-photo-3589898.jpeg?auto=compress&cs=tinysrgb&w=600&q=80\"/>\n                        </div>\n                        <div class=\"pt-6 text-center font-groovy italic text-2xl\" data-kid=\"4-2-1-1-1-1-3\" data-name=\"about photo caption\">\n                            Lado B: La inspiración.\n                        </div>\n                    </div>\n                    <!-- Second photo behind -->\n                    <div class=\"absolute top-10 left-10 w-full h-full bg-[var(--color-text)]/5 -z-10 rounded-sm\" data-kid=\"4-2-1-1-1-2\" data-name=\"about background depth layer\">\n                    </div>\n                </div>\n                <div class=\"lg:col-span-7 gsap-about-reveal\" data-kid=\"4-2-1-1-2\" data-name=\"about information text block\">\n                    <h2 class=\"font-groovy text-6xl lg:text-8xl mb-12\" data-kid=\"4-2-1-1-2-1\" data-name=\"about section headline\">\n                        Detrás del\n                        <span class=\"italic text-[var(--color-accent-2)]\" data-kid=\"4-2-1-1-2-1-1\" data-name=\"about headline italic highlight\">\n                            micrófono\n                        </span>\n                        .\n                    </h2>\n                    <div class=\"text-xl space-y-8 opacity-90 leading-relaxed max-w-2xl\" data-kid=\"4-2-1-1-2-2\" data-name=\"about text paragraphs container\">\n                        <p data-kid=\"4-2-1-1-2-2-1\" data-name=\"about paragraph one\">\n                            Empecé mi viaje en el desarrollo buscando la misma sensación que produce un viejo disco de vinilo: imperfecciones perfectas, calidez y una historia que contar.\n                        </p>\n                        <p data-kid=\"4-2-1-1-2-2-2\" data-name=\"about paragraph two\">\n                            Hoy, fusiono esa estética analógica con tecnologías de vanguardia para construir sitios web que no solo funcionan, sino que se sienten vivos.\n                        </p>\n                    </div>\n                    <div class=\"mt-16 flex flex-wrap gap-4\" data-kid=\"4-2-1-1-2-3\" data-name=\"about skill tags container\">\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-1\" data-name=\"skill tag item\">\n                            React / Next.js\n                        </span>\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-2\" data-name=\"skill tag item\">\n                            Tailwind v4\n                        </span>\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-3\" data-name=\"skill tag item\">\n                            Node / Prisma\n                        </span>\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-4\" data-name=\"skill tag item\">\n                            GSAP / Framer\n                        </span>\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-5\" data-name=\"skill tag item\">\n                            UI Design\n                        </span>\n                        <span class=\"dymo-label\" data-kid=\"4-2-1-1-2-3-6\" data-name=\"skill tag item\">\n                            Analog Vibes\n                        </span>\n                    </div>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- PROJECTS SECTION -->\n    <section class=\"py-40 bg-[var(--color-text)] text-[var(--color-bg)] overflow-hidden\" data-kid=\"4-3\" data-name=\"projects showcase section\" id=\"proyectos\">\n        <div class=\"container mx-auto px-10 flex flex-col md:flex-row justify-between items-end mb-24 gap-8\" data-kid=\"4-3-1\" data-name=\"projects section header container\">\n            <div data-kid=\"4-3-1-1\" data-name=\"projects section title group\">\n                <h2 class=\"font-groovy text-7xl lg:text-9xl tracking-tighter\" data-kid=\"4-3-1-1-1\" data-name=\"projects main headline\">\n                    Grandes\n                    <span class=\"italic text-[var(--color-accent-1)]\" data-kid=\"4-3-1-1-1-1\" data-name=\"projects headline italic highlight\">\n                        Éxitos\n                    </span>\n                </h2>\n                <p class=\"text-xl mt-6 opacity-60\" data-kid=\"4-3-1-1-2\" data-name=\"projects section sub-headline\">\n                    Una selección de mis lanzamientos más destacados.\n                </p>\n            </div>\n            <div class=\"flex items-center space-x-4 opacity-40 uppercase tracking-widest text-sm font-bold\" data-kid=\"4-3-1-2\" data-name=\"projects horizontal scroll hint\">\n                <span data-kid=\"4-3-1-2-1\" data-name=\"scroll hint text label\">\n                    Scroll Horizontal\n                </span>\n                <div class=\"w-12 h-[1px] bg-current\" data-kid=\"4-3-1-2-2\" data-name=\"scroll hint visual line\">\n                </div>\n            </div>\n        </div>\n        <div class=\"flex overflow-x-auto no-scrollbar pb-20 space-x-12 px-10\" data-kid=\"4-3-2\" data-name=\"projects carousel container\" style=\"scroll-snap-type: x mandatory;\">\n            <!-- Project 1 -->\n            <div class=\"min-w-[320px] md:min-w-[450px] flex-shrink-0\" data-kid=\"4-3-2-1\" data-name=\"project one card\" style=\"scroll-snap-align: start;\">\n                <div class=\"stacked-paper p-8 h-[600px] flex flex-col text-[var(--color-text)] group\" data-kid=\"4-3-2-1-1\" data-name=\"project one card interior container\">\n                    <div class=\"flex-grow overflow-hidden relative mb-8\" data-kid=\"4-3-2-1-1-1\" data-name=\"project one image wrapper\">\n                        <img alt=\"Project 1 by Kaan Tapucu\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000\" data-kid=\"4-3-2-1-1-1-1\" data-name=\"project one thumbnail image\" src=\"https://images.pexels.com/photos/9562125/pexels-photo-9562125.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                        <div class=\"absolute inset-0 bg-[var(--color-text)]/20 group-hover:opacity-0 transition-opacity duration-500\" data-kid=\"4-3-2-1-1-1-2\" data-name=\"project one image filter overlay\">\n                        </div>\n                    </div>\n                    <div class=\"text-xs font-bold opacity-50 uppercase tracking-widest mb-2\" data-kid=\"4-3-2-1-1-2\" data-name=\"project one metadata date\">\n                        Web Design / 2025\n                    </div>\n                    <h3 class=\"font-groovy text-4xl mb-4 group-hover:italic transition-all\" data-kid=\"4-3-2-1-1-3\" data-name=\"project one title\">\n                        Groovy Boutique\n                    </h3>\n                    <p class=\"opacity-70 line-clamp-2\" data-kid=\"4-3-2-1-1-4\" data-name=\"project one description\">\n                        Plataforma de e-commerce con una experiencia de usuario fluida y nostálgica.\n                    </p>\n                </div>\n            </div>\n            <!-- Project 2 -->\n            <div class=\"min-w-[320px] md:min-w-[450px] flex-shrink-0\" data-kid=\"4-3-2-2\" data-name=\"project two card\" style=\"scroll-snap-align: start;\">\n                <div class=\"stacked-paper p-8 h-[600px] flex flex-col text-[var(--color-text)] group\" data-kid=\"4-3-2-2-1\" data-name=\"project two card interior container\">\n                    <div class=\"flex-grow overflow-hidden relative mb-8\" data-kid=\"4-3-2-2-1-1\" data-name=\"project two image wrapper\">\n                        <img alt=\"Project 2 by Giuseppe Di Maria\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000\" data-kid=\"4-3-2-2-1-1-1\" data-name=\"project two thumbnail image\" src=\"https://images.pexels.com/photos/14435275/pexels-photo-14435275.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                        <div class=\"absolute inset-0 bg-[var(--color-text)]/20 group-hover:opacity-0 transition-opacity duration-500\" data-kid=\"4-3-2-2-1-1-2\" data-name=\"project two image filter overlay\">\n                        </div>\n                    </div>\n                    <div class=\"text-xs font-bold opacity-50 uppercase tracking-widest mb-2\" data-kid=\"4-3-2-2-1-2\" data-name=\"project two metadata date\">\n                        Development / 2024\n                    </div>\n                    <h3 class=\"font-groovy text-4xl mb-4 group-hover:italic transition-all\" data-kid=\"4-3-2-2-1-3\" data-name=\"project two title\">\n                        Analog Synth Web\n                    </h3>\n                    <p class=\"opacity-70 line-clamp-2\" data-kid=\"4-3-2-2-1-4\" data-name=\"project two description\">\n                        Sintetizador polifónico interactivo construido íntegramente con Web Audio API.\n                    </p>\n                </div>\n            </div>\n            <!-- Project 3 -->\n            <div class=\"min-w-[320px] md:min-w-[450px] flex-shrink-0\" data-kid=\"4-3-2-3\" data-name=\"project three card\" style=\"scroll-snap-align: start;\">\n                <div class=\"stacked-paper p-8 h-[600px] flex flex-col text-[var(--color-text)] group\" data-kid=\"4-3-2-3-1\" data-name=\"project three card interior container\">\n                    <div class=\"flex-grow overflow-hidden relative mb-8\" data-kid=\"4-3-2-3-1-1\" data-name=\"project three image wrapper\">\n                        <img alt=\"Project 3 by Ron Lach\" class=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-1000\" data-kid=\"4-3-2-3-1-1-1\" data-name=\"project three thumbnail image\" src=\"https://images.pexels.com/photos/10272685/pexels-photo-10272685.jpeg?auto=compress&cs=tinysrgb&w=800&q=80\"/>\n                        <div class=\"absolute inset-0 bg-[var(--color-text)]/20 group-hover:opacity-0 transition-opacity duration-500\" data-kid=\"4-3-2-3-1-1-2\" data-name=\"project three image filter overlay\">\n                        </div>\n                    </div>\n                    <div class=\"text-xs font-bold opacity-50 uppercase tracking-widest mb-2\" data-kid=\"4-3-2-3-1-2\" data-name=\"project three metadata date\">\n                        Branding / 2024\n                    </div>\n                    <h3 class=\"font-groovy text-4xl mb-4 group-hover:italic transition-all\" data-kid=\"4-3-2-3-1-3\" data-name=\"project three title\">\n                        Retro Studio Labs\n                    </h3>\n                    <p class=\"opacity-70 line-clamp-2\" data-kid=\"4-3-2-3-1-4\" data-name=\"project three description\">\n                        Identidad visual y portafolio para una agencia creativa enfocada en lo vintage.\n                    </p>\n                </div>\n            </div>\n        </div>\n    </section>\n    <!-- CONTACT SECTION -->\n    <section class=\"py-60 px-10 bg-[var(--color-bg)] flex justify-center items-center relative overflow-hidden\" data-kid=\"4-4\" data-name=\"contact section\" id=\"contacto\">\n        <div class=\"w-full max-w-3xl bg-[#fffcf0] p-16 md:p-24 shadow-[30px_30px_0px_rgba(150,75,0,0.05)] border border-[var(--color-text)]/10 relative gsap-contact-reveal\" data-kid=\"4-4-1\" data-name=\"contact card container\">\n            <!-- Stamp Seal -->\n            <div class=\"absolute top-10 right-10 w-32 h-32 border-4 border-dashed border-[var(--color-accent-1)]/40 rounded-full flex items-center justify-center rotate-12\" data-kid=\"4-4-1-1\" data-name=\"decorative stamp seal\">\n                <div class=\"text-center font-groovy font-black text-[var(--color-accent-1)] leading-none text-sm opacity-60\" data-kid=\"4-4-1-1-1\" data-name=\"stamp seal text\">\n                    DELIVERED\n                    <br data-kid=\"4-4-1-1-1-1\" data-name=\"stamp seal text break\"/>\n                    BY\n                    <br data-kid=\"4-4-1-1-1-2\" data-name=\"stamp seal text break\"/>\n                    HAND\n                </div>\n            </div>\n            <h2 class=\"font-groovy text-6xl md:text-8xl mb-12\" data-kid=\"4-4-1-2\" data-name=\"contact headline\">\n                Hagamos\n                <span class=\"text-[var(--color-accent-1)] underline decoration-dotted\" data-kid=\"4-4-1-2-1\" data-name=\"contact headline decorated highlight\">\n                    ruido\n                </span>\n                juntos.\n            </h2>\n            <p class=\"text-2xl italic opacity-80 leading-relaxed mb-16\" data-kid=\"4-4-1-3\" data-name=\"contact subheadline description\">\n                \"El futuro es solo el pasado vuelto a imaginar.\" Si tienes una idea que necesite ese toque especial, estoy a solo un mensaje de distancia.\n            </p>\n            <div class=\"space-y-6\" data-kid=\"4-4-1-4\" data-name=\"contact links container\">\n                <a class=\"block font-groovy text-4xl md:text-5xl hover:text-[var(--color-accent-1)] transition-colors underline underline-offset-8\" data-kid=\"4-4-1-4-1\" data-name=\"contact email address link\" href=\"mailto:hola@portafolio.com\">\n                    hola@portafolio.com\n                </a>\n                <div class=\"flex flex-wrap gap-10 pt-10 font-groovy text-xl\" data-kid=\"4-4-1-4-2\" data-name=\"contact social media link group\">\n                    <a class=\"hover:italic hover:translate-x-1 transition-all inline-block\" data-kid=\"4-4-1-4-2-1\" data-name=\"social link one\" href=\"#\">\n                        GITHUB\n                    </a>\n                    <a class=\"hover:italic hover:translate-x-1 transition-all inline-block\" data-kid=\"4-4-1-4-2-2\" data-name=\"social link two\" href=\"#\">\n                        LINKEDIN\n                    </a>\n                    <a class=\"hover:italic hover:translate-x-1 transition-all inline-block\" data-kid=\"4-4-1-4-2-3\" data-name=\"social link three\" href=\"#\">\n                        TWITTER\n                    </a>\n                </div>\n            </div>\n            <div class=\"mt-24 pt-8 border-t border-[var(--color-text)]/10 text-xs font-bold uppercase tracking-widest opacity-40\" data-kid=\"4-4-1-5\" data-name=\"contact section location footer\">\n                Ubicación: Algún lugar entre 1970 y el presente.\n            </div>\n        </div>\n        <!-- Background Decoration -->\n        <div class=\"absolute top-0 right-0 w-1/3 h-full bg-[var(--color-accent-1)]/5 -z-10 diagonal-bg\" data-kid=\"4-4-2\" data-name=\"contact background decoration layer\">\n        </div>\n    </section>\n</main>\n<footer class=\"py-16 bg-[var(--color-bg)] border-t border-[var(--color-text)]/5 px-10\" data-kid=\"5\" data-name=\"footer section\">\n    <div class=\"container mx-auto flex flex-col md:flex-row justify-between items-center gap-8\" data-kid=\"5-1\" data-name=\"footer content container\">\n        <div class=\"font-groovy text-2xl font-black\" data-kid=\"5-1-1\" data-name=\"footer logo\">\n            RED70\n        </div>\n        <div class=\"text-sm opacity-60 font-medium\" data-kid=\"5-1-2\" data-name=\"footer copyright text\">\n            © 2026 — TODOS LOS DERECHOS RESERVADOS AL RITMO DEL GROOVE.\n        </div>\n        <div class=\"flex space-x-6\" data-kid=\"5-1-3\" data-name=\"footer accent color indicators\">\n            <div class=\"w-8 h-8 rounded-full bg-[var(--color-accent-1)]\" data-kid=\"5-1-3-1\" data-name=\"accent color indicator circle one\">\n            </div>\n            <div class=\"w-8 h-8 rounded-full bg-[var(--color-accent-2)]\" data-kid=\"5-1-3-2\" data-name=\"accent color indicator circle two\">\n            </div>\n            <div class=\"w-8 h-8 rounded-full bg-[var(--color-text)]\" data-kid=\"5-1-3-3\" data-name=\"accent color indicator circle three\">\n            </div>\n        </div>\n    </div>\n</footer>\n<!-- External Libraries -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script>\n    gsap.registerPlugin(ScrollTrigger);\n\n  window.addEventListener('DOMContentLoaded', () => {\n    const tl = gsap.timeline();\n    \n    tl.from(\".gsap-hero-text\", {\n      y: 100,\n      autoAlpha: 0,\n      duration: 1.2,\n      stagger: 0.15,\n      ease: \"power4.out\"\n    })\n    .from(\".gsap-hero-image\", {\n      scale: 0.8,\n      autoAlpha: 0,\n      duration: 1.5,\n      ease: \"expo.out\"\n    }, \"-=1\");\n\n    gsap.from(\".gsap-about-reveal\", {\n      y: 60,\n      autoAlpha: 0,\n      duration: 1,\n      stagger: 0.3,\n      ease: \"power3.out\",\n      scrollTrigger: {\n        trigger: \"#sobre\",\n        start: \"top 70%\"\n      }\n    });\n\n    gsap.from(\".gsap-contact-reveal\", {\n      scale: 0.9,\n      autoAlpha: 0,\n      duration: 1.2,\n      ease: \"back.out(1.7)\",\n      scrollTrigger: {\n        trigger: \"#contacto\",\n        start: \"top 60%\"\n      }\n    });\n\n    const cursor = document.querySelector(\".custom-cursor\");\n    if (window.innerWidth > 768) {\n      cursor.style.display = \"block\";\n      window.addEventListener(\"mousemove\", (e) => {\n        gsap.to(cursor, {\n          x: e.clientX,\n          y: e.clientY,\n          duration: 0.1,\n          ease: \"none\"\n        });\n      });\n    }\n  });\n</script>\n",
