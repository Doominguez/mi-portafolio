  "nodes": {
    "var_61e723876aa5": {
      "type": "variant",
      "label": "Midnight Disco",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 0,
        "y": 0,
        "w": 1440,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Abril+Fatface&family=Alegreya:wght@400;500;700&display=swap');\n  @import \"https://unpkg.com/lenis@1/dist/lenis.css\";\n\n  :root {\n    --color-mahogany: #3D0C02;\n    --color-goldenrod: #DAA520;\n    --color-burnt-orange: #C04000;\n    --color-beige: #F5F5DC;\n    --font-heading: 'Abril Fatface', serif;\n    --font-body: 'Alegreya', serif;\n  }\n\n  body {\n    background-color: var(--color-mahogany);\n    color: var(--color-beige);\n    font-family: var(--font-body);\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-heading { font-family: var(--font-heading); }\n  .text-goldenrod { color: var(--color-goldenrod); }\n  .text-burnt-orange { color: var(--color-burnt-orange); }\n  .border-goldenrod { border-color: var(--color-goldenrod); }\n\n  /* #dark-spotlight */\n  .spotlight-overlay {\n    background: radial-gradient(600px circle at var(--x, 50%) var(--y, 50%), rgba(218, 165, 32, 0.15) 0%, transparent 100%);\n    pointer-events: none;\n    position: fixed;\n    inset: 0;\n    z-index: 10;\n  }\n\n  /* #neon-glow */\n  .pill-glow {\n    border: 1.5px solid var(--color-burnt-orange);\n    box-shadow: 0 0 12px rgba(192, 64, 0, 0.2), 0 0 36px rgba(192, 64, 0, 0.1);\n  }\n\n  /* #peephole */\n  .peephole {\n    mask-image: radial-gradient(circle, black 100%, transparent 100%);\n    -webkit-mask-image: radial-gradient(circle, black 100%, transparent 100%);\n  }\n\n  /* #film-strip */\n  .film-strip-edge {\n    background: repeating-linear-gradient(90deg, #1a1a1a, #1a1a1a 8px, transparent 8px, transparent 12px);\n  }\n\n  /* Custom Scrollbar */\n  ::-webkit-scrollbar { width: 8px; }\n  ::-webkit-scrollbar-track { background: var(--color-mahogany); }\n  ::-webkit-scrollbar-thumb { background: var(--color-goldenrod); border-radius: 4px; }\n</style>\n<div class=\"spotlight-overlay\" data-dynamic=\"true\" data-kid=\"1\" data-name=\"mouse-tracking spotlight overlay\" data-reason=\"CSS variables for position updated by pointermove event\" id=\"spotlight\">\n</div>\n<!-- Nav -->\n<nav class=\"fixed top-0 w-full z-50 px-12 py-8 flex justify-between items-center bg-transparent backdrop-blur-sm\" data-kid=\"2\" data-name=\"main navigation bar\">\n    <div class=\"font-heading text-3xl text-goldenrod tracking-tighter\" data-kid=\"2-1\" data-name=\"portfolio logo text\">\n        PORTFOLIO.74\n    </div>\n    <div class=\"hidden md:flex gap-12 text-lg font-medium uppercase tracking-widest\" data-kid=\"2-2\" data-name=\"navigation link container\">\n        <a class=\"hover:text-goldenrod transition-colors\" data-kid=\"2-2-1\" data-name=\"about navigation link\" href=\"#sobre\">\n            Sobre\n        </a>\n        <a class=\"hover:text-goldenrod transition-colors\" data-kid=\"2-2-2\" data-name=\"projects navigation link\" href=\"#proyectos\">\n            Proyectos\n        </a>\n        <a class=\"hover:text-goldenrod transition-colors\" data-kid=\"2-2-3\" data-name=\"contact navigation link\" href=\"#contacto\">\n            Contacto\n        </a>\n    </div>\n</nav>\n<!-- Hero Section -->\n<section class=\"relative h-screen flex flex-col justify-center px-12 md:px-24 overflow-hidden\" data-kid=\"3\" data-name=\"hero section\">\n    <div class=\"relative z-20 max-w-5xl\" data-kid=\"3-1\" data-name=\"hero content container\">\n        <div class=\"flex items-center gap-4 mb-8\" data-kid=\"3-1-1\" data-name=\"availability status container\">\n            <div class=\"pill-glow px-6 py-2 rounded-full flex items-center gap-2\" data-kid=\"3-1-1-1\" data-name=\"status pill wrapper\">\n                <img class=\"w-5 h-5\" data-kid=\"3-1-1-1-1\" data-name=\"pill icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/pill.svg\" style=\"filter: invert(34%) sepia(98%) saturate(2256%) hue-rotate(5deg) brightness(95%) contrast(101%);\"/>\n                <span class=\"text-xs uppercase tracking-[0.3em] font-bold text-burnt-orange\" data-kid=\"3-1-1-1-2\" data-name=\"availability status text\">\n                    Available for collab\n                </span>\n            </div>\n        </div>\n        <!-- #giant-headline -->\n        <h1 class=\"font-heading text-8xl md:text-[12rem] leading-[0.85] text-goldenrod mb-12\" data-kid=\"3-1-2\" data-name=\"hero headline text\">\n            Creative\n            <br data-kid=\"3-1-2-1\" data-name=\"headline line break\"/>\n            Engineer.\n        </h1>\n        <p class=\"text-2xl md:text-3xl max-w-2xl leading-relaxed text-beige/80 italic\" data-kid=\"3-1-3\" data-name=\"hero subheadline description text\">\n            \"Crafting digital experiences with a touch of 70s soul and a vision for the future.\"\n        </p>\n    </div>\n</section>\n<!-- #orbit About Section -->\n<section class=\"relative min-h-screen py-32 flex flex-col items-center justify-center bg-[#2D0901]\" data-kid=\"4\" data-name=\"about section\" id=\"sobre\">\n    <div class=\"max-w-7xl w-full px-12 relative flex flex-col lg:flex-row items-center gap-24\" data-kid=\"4-1\" data-name=\"about content layout container\">\n        <!-- Orbit Hub -->\n        <div class=\"relative w-[500px] h-[500px] flex items-center justify-center\" data-kid=\"4-1-1\" data-name=\"orbiting hub container\">\n            <!-- #peephole central portrait -->\n            <div class=\"relative z-10 w-64 h-64 rounded-full overflow-hidden border-4 border-goldenrod shadow-2xl peephole\" data-kid=\"4-1-1-1\" data-name=\"portrait peephole container\">\n                <img alt=\"Portrait - Nitin Mendekar on Unsplash\" class=\"w-full h-full object-cover grayscale brightness-75 contrast-125\" data-dynamic=\"true\" data-kid=\"4-1-1-1-1\" data-name=\"portrait image\" data-reason=\"image filters and scale reinitialized by scroll trigger\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1544501652-c92e7f9ff497?auto=format&w=600&q=80&fit=crop\"/>\n            </div>\n            <!-- Orbiting Skills -->\n            <div class=\"absolute inset-0 border-[1px] border-dashed border-goldenrod/30 rounded-full animate-[spin_20s_linear_infinite]\" data-kid=\"4-1-1-2\" data-name=\"outer orbit ring\">\n            </div>\n            <div class=\"absolute inset-12 border-[1px] border-dashed border-goldenrod/20 rounded-full animate-[spin_15s_linear_infinite_reverse]\" data-kid=\"4-1-1-3\" data-name=\"inner orbit ring\">\n            </div>\n            <!-- Skill Pills -->\n            <div class=\"absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 bg-mahogany border border-goldenrod px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest skill-item\" data-kid=\"4-1-1-4\" data-name=\"Next.js skill pill\">\n                Next.js\n            </div>\n            <div class=\"absolute bottom-0 left-1/2 -translate-x-1/2 translate-y-1/2 bg-mahogany border border-goldenrod px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest skill-item\" data-kid=\"4-1-1-5\" data-name=\"TypeScript skill pill\">\n                TypeScript\n            </div>\n            <div class=\"absolute left-0 top-1/2 -translate-y-1/2 -translate-x-1/2 bg-mahogany border border-goldenrod px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest skill-item\" data-kid=\"4-1-1-6\" data-name=\"Prisma skill pill\">\n                Prisma\n            </div>\n            <div class=\"absolute right-0 top-1/2 -translate-y-1/2 translate-x-1/2 bg-mahogany border border-goldenrod px-4 py-2 rounded-full text-xs font-bold uppercase tracking-widest skill-item\" data-kid=\"4-1-1-7\" data-name=\"Tailwind skill pill\">\n                Tailwind\n            </div>\n        </div>\n        <!-- About Content -->\n        <div class=\"flex-1\" data-kid=\"4-1-2\" data-name=\"about textual content container\">\n            <h2 class=\"font-heading text-6xl text-goldenrod mb-8\" data-kid=\"4-1-2-1\" data-name=\"about headline text\">\n                Nostalgic\n                <br data-kid=\"4-1-2-1-1\" data-name=\"headline line break\"/>\n                by nature.\n            </h2>\n            <div class=\"space-y-6 text-xl leading-relaxed text-beige/90\" data-kid=\"4-1-2-2\" data-name=\"about description paragraph container\">\n                <p data-kid=\"4-1-2-2-1\" data-name=\"first about paragraph\">\n                    I am a developer who believes technology should feel as warm as a vinyl record. Based on the project structure I found, I specialize in building robust full-stack applications using the modern stack but with an eye for timeless aesthetics.\n                </p>\n                <p data-kid=\"4-1-2-2-2\" data-name=\"second about paragraph\">\n                    My work is a blend of precision and soul. I don't just write code; I compose interfaces that sing.\n                </p>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- #alternating-rows Projects Section -->\n<section class=\"relative overflow-hidden\" data-kid=\"5\" data-name=\"projects section\" id=\"proyectos\">\n    <div class=\"film-strip-edge h-8 w-full\" data-kid=\"5-1\" data-name=\"top film strip border\">\n    </div>\n    <!-- Project Row 1 -->\n    <div class=\"relative min-h-[70vh] flex flex-col md:flex-row items-center border-b border-goldenrod/10 group\" data-kid=\"5-2\" data-name=\"first project row\">\n        <div class=\"flex-1 p-12 md:p-24\" data-kid=\"5-2-1\" data-name=\"first project text content\">\n            <div class=\"text-burnt-orange font-bold uppercase tracking-[0.4em] mb-4\" data-kid=\"5-2-1-1\" data-name=\"first project case study label\">\n                Case Study 01\n            </div>\n            <h3 class=\"font-heading text-6xl md:text-8xl text-goldenrod mb-8\" data-kid=\"5-2-1-2\" data-name=\"first project title text\">\n                Audio Visualizer\n            </h3>\n            <p class=\"text-xl max-w-xl text-beige/70 mb-12\" data-kid=\"5-2-1-3\" data-name=\"first project description text\">\n                A real-time audio analysis tool that renders frequencies as psychedelic 70s patterns. Built with Web Audio API.\n            </p>\n            <a class=\"inline-flex items-center gap-4 text-goldenrod font-bold uppercase tracking-widest hover:translate-x-4 transition-transform duration-500\" data-kid=\"5-2-1-4\" data-name=\"first project explore link\" href=\"#\">\n                EXPLORE PROJECT\n                <span class=\"text-2xl\" data-kid=\"5-2-1-4-1\" data-name=\"first project arrow icon\">\n                    →\n                </span>\n            </a>\n        </div>\n        <div class=\"flex-1 h-full min-h-[500px] overflow-hidden\" data-kid=\"5-2-2\" data-name=\"first project image container\">\n            <img alt=\"Studio - Soundsitive Studio on Unsplash\" class=\"w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-1000 ease-out\" data-kid=\"5-2-2-1\" data-name=\"first project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.unsplash.com/photo-1760780567530-389d8a3fba75?auto=format&w=1200&q=80&fit=crop\"/>\n        </div>\n    </div>\n    <!-- Project Row 2 -->\n    <div class=\"relative min-h-[70vh] flex flex-col md:flex-row-reverse items-center border-b border-goldenrod/10 bg-mahogany/50 group\" data-kid=\"5-3\" data-name=\"second project row\">\n        <div class=\"flex-1 p-12 md:p-24\" data-kid=\"5-3-1\" data-name=\"second project text content\">\n            <div class=\"text-burnt-orange font-bold uppercase tracking-[0.4em] mb-4\" data-kid=\"5-3-1-1\" data-name=\"second project case study label\">\n                Case Study 02\n            </div>\n            <h3 class=\"font-heading text-6xl md:text-8xl text-goldenrod mb-8\" data-kid=\"5-3-1-2\" data-name=\"second project title text\">\n                Analog Ledger\n            </h3>\n            <p class=\"text-xl max-w-xl text-beige/70 mb-12\" data-kid=\"5-3-1-3\" data-name=\"second project description text\">\n                A financial management dashboard with a focus on typewriter-style data entry and ledger-inspired grids.\n            </p>\n            <a class=\"inline-flex items-center gap-4 text-goldenrod font-bold uppercase tracking-widest hover:-translate-x-4 transition-transform duration-500\" data-kid=\"5-3-1-4\" data-name=\"second project explore link\" href=\"#\">\n                EXPLORE PROJECT\n                <span class=\"text-2xl\" data-kid=\"5-3-1-4-1\" data-name=\"second project arrow icon\">\n                    →\n                </span>\n            </a>\n        </div>\n        <div class=\"flex-1 h-full min-h-[500px] overflow-hidden\" data-kid=\"5-3-2\" data-name=\"second project image container\">\n            <img alt=\"Vintage Collection - Javier Zari U. on Pexels\" class=\"w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-1000 ease-out\" data-kid=\"5-3-2-1\" data-name=\"second project image\" decoding=\"async\" loading=\"lazy\" src=\"https://images.pexels.com/photos/35420579/pexels-photo-35420579.jpeg?auto=compress&cs=tinysrgb&w=1200&q=80\"/>\n        </div>\n    </div>\n    <div class=\"film-strip-edge h-8 w-full rotate-180\" data-kid=\"5-4\" data-name=\"bottom film strip border\">\n    </div>\n</section>\n<!-- #bottom-left Contact Section -->\n<section class=\"relative h-screen flex flex-col justify-end p-12 md:p-24 overflow-hidden bg-[#1D0601]\" data-kid=\"6\" data-name=\"contact section\" id=\"contacto\">\n    <!-- #starburst decoration -->\n    <div class=\"absolute top-24 right-24 w-64 h-64 md:w-96 md:h-96 starburst\" data-kid=\"6-1\" data-name=\"starburst decorative container\">\n        <img class=\"w-full h-full opacity-20 animate-[spin_60s_linear_infinite]\" data-kid=\"6-1-1\" data-name=\"starburst icon\" src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/lorc/rainbow-star.svg\" style=\"filter: invert(34%) sepia(98%) saturate(2256%) hue-rotate(5deg) brightness(95%) contrast(101%);\"/>\n    </div>\n    <div class=\"relative z-10 max-w-4xl\" data-kid=\"6-2\" data-name=\"contact info layout container\">\n        <h2 class=\"font-heading text-7xl md:text-[10rem] text-goldenrod leading-none mb-12\" data-kid=\"6-2-1\" data-name=\"contact headline text\">\n            Get in\n            <br data-kid=\"6-2-1-1\" data-name=\"headline line break\"/>\n            Touch.\n        </h2>\n        <div class=\"flex flex-col md:flex-row gap-12 md:gap-32 text-xl font-medium tracking-widest uppercase\" data-kid=\"6-2-2\" data-name=\"contact details container\">\n            <div class=\"space-y-4\" data-kid=\"6-2-2-1\" data-name=\"inquiries contact section\">\n                <div class=\"text-burnt-orange text-xs font-bold\" data-kid=\"6-2-2-1-1\" data-name=\"inquiries label\">\n                    Inquiries\n                </div>\n                <a class=\"block hover:text-goldenrod transition-colors\" data-kid=\"6-2-2-1-2\" data-name=\"inquiries email link\" href=\"mailto:hello@retrodev.com\">\n                    hello@retrodev.com\n                </a>\n            </div>\n            <div class=\"space-y-4\" data-kid=\"6-2-2-2\" data-name=\"social links contact section\">\n                <div class=\"text-burnt-orange text-xs font-bold\" data-kid=\"6-2-2-2-1\" data-name=\"social links label\">\n                    Social\n                </div>\n                <div class=\"flex flex-wrap gap-8\" data-kid=\"6-2-2-2-2\" data-name=\"social media link list\">\n                    <a class=\"hover:text-goldenrod transition-colors underline decoration-burnt-orange underline-offset-8\" data-kid=\"6-2-2-2-2-1\" data-name=\"GitHub link\" href=\"#\">\n                        GitHub\n                    </a>\n                    <a class=\"hover:text-goldenrod transition-colors underline decoration-burnt-orange underline-offset-8\" data-kid=\"6-2-2-2-2-2\" data-name=\"LinkedIn link\" href=\"#\">\n                        LinkedIn\n                    </a>\n                    <a class=\"hover:text-goldenrod transition-colors underline decoration-burnt-orange underline-offset-8\" data-kid=\"6-2-2-2-2-3\" data-name=\"Instagram link\" href=\"#\">\n                        Instagram\n                    </a>\n                </div>\n            </div>\n        </div>\n    </div>\n</section>\n<!-- Footer -->\n<footer class=\"py-12 px-12 border-t border-goldenrod/10 flex flex-col md:flex-row justify-between items-center gap-8 text-beige/40 uppercase tracking-widest text-xs\" data-kid=\"7\" data-name=\"footer bar\">\n    <div data-kid=\"7-1\" data-name=\"copyright notice text\">\n        © 2026 Midnight Disco Portfolio\n    </div>\n    <div data-kid=\"7-2\" data-name=\"crafting mission text\">\n        Crafted with soul and code\n    </div>\n    <div data-kid=\"7-3\" data-name=\"tech stack credit text\">\n        Next.js + Framer + GSAP\n    </div>\n</footer>\n<!-- Scripts -->\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/gsap.min.js\">\n</script>\n<script src=\"https://cdn.jsdelivr.net/npm/gsap@3/dist/ScrollTrigger.min.js\">\n</script>\n<script type=\"module\">\n    import { animate, scroll, motionValue } from \"https://cdn.jsdelivr.net/npm/motion@12/+esm\"\n  import Lenis from \"https://esm.sh/lenis@1\"\n\n  // Smooth Scroll\n  const lenis = new Lenis()\n  function raf(time) {\n    lenis.raf(time)\n    requestAnimationFrame(raf)\n  }\n  requestAnimationFrame(raf)\n\n  // #motion-pointer-follow spotlight\n  const spotlight = document.getElementById('spotlight');\n  document.addEventListener('pointermove', (e) => {\n    spotlight.style.setProperty('--x', `${e.clientX}px`);\n    spotlight.style.setProperty('--y', `${e.clientY}px`);\n  });\n\n  // GSAP Animations\n  gsap.registerPlugin(ScrollTrigger);\n\n  // Hero Text Entrance\n  gsap.from(\"h1\", {\n    y: 100,\n    opacity: 0,\n    duration: 1.5,\n    ease: \"power4.out\",\n    delay: 0.5\n  });\n\n  // #gsap-pin-scrub-scene for About Section\n  gsap.to(\".peephole img\", {\n    scale: 1.5,\n    filter: \"grayscale(0) brightness(1) contrast(1)\",\n    scrollTrigger: {\n      trigger: \"#sobre\",\n      start: \"top bottom\",\n      end: \"bottom top\",\n      scrub: 1\n    }\n  });\n\n  // Project Reveal Stagger\n  const projectRows = document.querySelectorAll('#proyectos > div:not(.film-strip-edge)');\n  projectRows.forEach((row, i) => {\n    const isEven = i % 2 !== 0;\n    gsap.from(row.querySelector('h3'), {\n      x: isEven ? 100 : -100,\n      opacity: 0,\n      duration: 1,\n      scrollTrigger: {\n        trigger: row,\n        start: \"top 80%\",\n      }\n    });\n  });\n\n  // Starburst Wobble\n  const starburst = document.querySelector('.starburst');\n  starburst.addEventListener('mouseenter', () => {\n    animate(starburst, { rotate: [0, -15, 15, -10, 10, 0] }, { duration: 1, ease: \"spring\" });\n  });\n</script>\n",
      "comments": [],
      "created": "2026-07-21T23:42:28.337764+00:00",
      "modified": "2026-07-21T23:42:53.197034+00:00",
